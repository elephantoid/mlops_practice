# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/

# uv
# uv.lock is committed intentionally — do not add it here

# Environment
.env

# Data
data/raw/
data/processed/
*.parquet

# MLflow
mlruns/
mlartifacts/
mlflow.db

# Model exported for the Docker build (src/models/export.py)
build/

# Logs / reports
logs/*.jsonl
reports/*.html

# Archify visual-check evidence: screenshots and receipts from `visual-check`, written
# beside the artifact on every run. Regenerable, and the committed thing is the HTML.
docs/*.visual-check.*

# Notebooks checkpoints
.ipynb_checkpoints/

# GCP credentials.
# Deliberately NOT a blanket *.json: that rule silently swallowed the Grafana dashboard
# in monitoring/grafana/dashboards/, so `git add` skipped it without complaint and the
# repo shipped provisioning config pointing at an empty directory. Secret scanning is
# handled by the gitleaks and detect-private-key pre-commit hooks, which check content
# rather than file extension.
gcp-key.json
*-credentials.json
*-service-account.json
service-account*.json

# macOS
.DS_Store

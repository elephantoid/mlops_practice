{
  "uid": "riskwatch",
  "title": "RiskWatch",
  "tags": ["riskwatch", "mlops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
          "expr": "sum by (endpoint) (rate(riskwatch_requests_total[1m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency p50 / p95 (/predict/*)",
      "description": "Buckets start at 1ms; the prometheus_client defaults start at 5ms and would flatten every percentile for a 2-3ms service.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(riskwatch_request_latency_seconds_bucket{endpoint=~\"/predict/.*\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(riskwatch_request_latency_seconds_bucket{endpoint=~\"/predict/.*\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Prediction distribution",
      "description": "A sudden shift here is an early signal of input drift, ahead of any labels arriving.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
          "expr": "sum by (track, decision) (riskwatch_predictions_total)",
          "legendFormat": "{{track}} {{decision}}",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate (5xx)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
          "expr": "sum(rate(riskwatch_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(riskwatch_requests_total[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Prediction log writes",
      "description": "The logger swallows exceptions so it can never break serving. This is the only signal that it stopped working.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
          "expr": "sum by (sink, status) (riskwatch_prediction_log_total)",
          "legendFormat": "{{sink}} {{status}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Client errors (4xx)",
      "description": "Separate from the 5xx panel on purpose: a 4xx is the caller sending something invalid, not the service failing, so it must not pollute the error-rate SLI. But a spike still matters -- it usually means a client integration broke or someone is probing. 422 is schema rejection, 404 is an unmatched path.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
          "expr": "sum by (status, endpoint) (rate(riskwatch_requests_total{status=~\"4..\"}[1m]))",
          "legendFormat": "{{status}} {{endpoint}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Data drift share",
      "description": "Populated by src/monitoring/drift.py in step 3. Reads No data until then. Milestone 4 retrains when this crosses 0.2.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "riskwatch-prometheus" },
          "expr": "riskwatch_drift_share"
        }
      ]
    }
  ]
}

# GCP
GCP_PROJECT_ID=your-project-id
GCS_BUCKET=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=churnwatch

# API
MODEL_NAME=churnwatch
MODEL_STAGE=Production
PORT=8000

# Airflow (docker-compose.airflow.yml). Required -- compose refuses to start without them,
# rather than falling back to a default that would be a committed credential.
POSTGRES_PASSWORD=change-me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# On Linux only: export AIRFLOW_UID=$(id -u) so containers do not write root-owned files.
AIRFLOW_UID=50000
